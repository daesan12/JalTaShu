[Unit]
Description=Export Tashu Collector health as Prometheus textfile metrics
After=tashu-collector.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/tashu-collector-metrics
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/node_exporter/textfile_collector
