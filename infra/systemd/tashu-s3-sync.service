[Unit]
Description=Upload completed Tashu Parquet snapshots to private S3 Bronze storage
Wants=network-online.target
After=network-online.target tashu-collector.service

[Service]
Type=oneshot
User=tashu-collector
Group=tashu-collector
Environment=AWS_SHARED_CREDENTIALS_FILE=/etc/tashu-collector/aws-credentials
Environment=AWS_DEFAULT_REGION=ap-northeast-2
Environment=AWS_EC2_METADATA_DISABLED=true
Environment=AWS_PAGER=
ExecStart=/usr/local/sbin/tashu-s3-sync
TimeoutStartSec=15min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
