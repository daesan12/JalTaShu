TASHU_KAFKA_BOOTSTRAP_SERVERS=172.26.4.110:9092
TASHU_STATION_TOPIC=tashu.station-availability.v1
TASHU_WEATHER_TOPIC=tashu.weather-observation.v1
TASHU_STREAM_CHECKPOINT_ROOT=/srv/tashu/spark/checkpoints/kafka-mysql-v2
TASHU_STREAM_DEAD_LETTER_ROOT=/srv/tashu/spark/output/dead-letter/kafka-mysql-v2
TASHU_STREAM_TRIGGER_SECONDS=10
TASHU_STREAM_STARTING_OFFSETS=earliest
TASHU_STREAM_MAX_OFFSETS_PER_TRIGGER=100000
LOG_LEVEL=INFO
SPARK_LOG_LEVEL=WARN

# The submit script injects these from /etc/tashu/streaming/mysql-data-writer.env.
# Never store real values in this file or Git.
TASHU_DATA_DB_JDBC_URL=
TASHU_DATA_DB_USER=
TASHU_DATA_DB_PASSWORD=
TASHU_DATA_DB_DRIVER=com.mysql.cj.jdbc.Driver
