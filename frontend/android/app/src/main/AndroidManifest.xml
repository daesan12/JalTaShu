<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!--
            세로 고정 — 지도·경로 안내·바텀시트가 모두 세로 기준으로 짜여 있어
            가로로 돌아가면 시트가 화면을 거의 덮는다. 기기 회전 잠금과 무관하게 세로로 둔다.
        -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!--
            #115 백그라운드 위치 서비스 — 다른 앱이 켤 수 없게 막는다.
            @capacitor-community/background-geolocation의 매니페스트가 exported="true"로
            선언하는데, 실제로는 우리 앱 안에서 명시적 인텐트로 bindService 하므로
            (BackgroundGeolocation.java:303) 외부 공개가 필요 없다. 열어 두면 다른 앱이
            우리 위치 서비스를 띄워 알림을 보이게 하고 GPS로 배터리를 태울 수 있다.
        -->
        <service
            android:name="com.equimaps.capacitor_background_geolocation.BackgroundGeolocationService"
            android:exported="false"
            tools:replace="android:exported" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- QR 스캔·민원 사진 촬영 (getUserMedia / 파일 선택 카메라) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- 현재 위치 (지도·경로 안내) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <!-- 알림 (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        경로 안내 중 백그라운드 위치 (#115) — 화면이 꺼져도 안내가 이어지게 포그라운드 서비스를 띄운다.
        플러그인 매니페스트에도 있지만, 이 앱이 포그라운드 서비스를 쓴다는 사실이 여기서 보여야 한다.
        ACCESS_BACKGROUND_LOCATION은 필요 없다 — 사용자가 화면을 보며 "안내 시작"을 누를 때
        서비스를 시작하므로 while-in-use 권한으로 충분하다.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
</manifest>
