# 이 파일을 복사해서 .env.local 로 만들고 실제 값을 채우세요. (.env.local은 git에 올라가지 않음)

# 백엔드 API 주소 (msw 사용 시에는 아무 값이어도 됨)
# staging 배포: /staging-api
VITE_API_BASE_URL=/api

# 백엔드 OAuth 시작 경로 (백엔드의 /auth/** 로 프록시되는 경로)
# staging 배포: /staging-auth
VITE_AUTH_BASE_URL=/auth

# 배포 경로 (빌드 시에만 사용). production: / (기본값), staging: /staging/
# VITE_BASE_PATH=/staging/

# 네이버 지도 Dynamic Map JS SDK 클라이언트 ID (NCP 콘솔에서 발급)
VITE_NAVER_MAP_CLIENT_ID=

# true면 msw 가짜 API 활성화 (백엔드 없이 개발할 때)
VITE_ENABLE_MSW=true
