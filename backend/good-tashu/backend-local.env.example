# Admin startup initialization (disabled by default; fill credentials in your private env file)
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_ID=
ADMIN_BOOTSTRAP_PASSWORD=

# MySQL
MYSQL_ROOT_PASSWORD=change-root-password
MYSQL_DATABASE=good_tashu
MYSQL_USER=good_tashu
MYSQL_PASSWORD=change-me

# Redis
REDIS_HOST=localhost
# 타슈 수집기가 발행하는 최신 전체 대여소 snapshot (기본 키)
# TASHU_STATION_REDIS_SNAPSHOT_KEY=tashu:station-availability:latest:v1
# TASHU_STATION_REDIS_LAST_KNOWN_KEY=tashu:station-availability:last-known:v1
# TASHU_STATION_REDIS_DATABASE=0
# AI 예측 pred:{stationId}:{1..15} (운영 기본 논리 DB 2)
# TASHU_PREDICTION_REDIS_DATABASE=2

# Email
EMAIL_CODE_LENGTH=6
EMAIL_EXPIRATION=300

# Kakao OAuth
KAKAO_REST_API_KEY=change-me
KAKAO_CLIENT_SECRET=change-me
FRONTEND_OAUTH_SUCCESS_URL=http://localhost:5173/oauth/success
FRONTEND_OAUTH_FAILURE_URL=http://localhost:5173/oauth/failure
OAUTH2_COOKIE_NAME=oauth2_authorization_request
OAUTH2_EXPIRES=180
# AWS S3 - fill in backend-local.env, not this example file
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only needed for temporary credentials
AWS_SESSION_TOKEN=
