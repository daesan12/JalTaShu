# MySQL
MYSQL_ROOT_PASSWORD=change-root-password
MYSQL_DATABASE=good_tashu
MYSQL_USER=good_tashu
MYSQL_PASSWORD=change-me

# Redis
REDIS_HOST=localhost

# Email
EMAIL_CODE_LENGTH=6
EMAIL_EXPIRATION=300

# Kakao OAuth
KAKAO_REST_API_KEY=change-me
KAKAO_CLIENT_SECRET=change-me
FRONTEND_OAUTH_SUCCESS_URL=http://localhost:5173/oauth/success
FRONTEND_OAUTH_FAILURE_URL=http://localhost:5173/oauth/failure
OAUTH2_COOKIE_NAME=oauth2_authorization_request
OAUTH2_EXPIRES=180
# AWS S3 - fill in backend-local.env, not this example file
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only needed for temporary credentials
AWS_SESSION_TOKEN=
