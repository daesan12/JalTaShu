# 로컬 Docker(dev/compose.yml) 접속값. 운영은 인프라가 /etc/tashu/ai-serving/mysql-reader.env 로 주입.
TASHU_AI_DB_HOST=127.0.0.1
TASHU_AI_DB_PORT=3307
TASHU_AI_DB_NAME=tashu_data
TASHU_AI_DB_USER=tashu_ai_reader
TASHU_AI_DB_PASSWORD=dev
TASHU_AI_REDIS_HOST=127.0.0.1
TASHU_AI_REDIS_PORT=6380
TASHU_AI_REDIS_DB=0
TASHU_AI_REDIS_PASSWORD=
